/lambdary

# .lambdary/ holds per-project local state (RIE cache, etc.) — ignored
# except the lock file, which is meant to be committed for reproducible
# digest pinning (DESIGN.md's version-pinning decision). A trailing-slash
# dir ignore can't be re-included by a later negation, per git's own
# semantics, hence the "/*" form here.
.lambdary/*
!.lambdary/lock

# Go
*.test
*.out

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Python bytecode caches from shim tests
__pycache__/

# Release build output (CI writes here; local dry-runs of the release loop too)
/dist/

# Per-target RIE binary CI places here before an embedrie build (see
# internal/rie/embedded/README.md) — never committed, README stays tracked.
/internal/rie/embedded/aws-lambda-rie

# examples/screenshot-node's Playwright dependency (examples/screenshot-node/README.md)
examples/screenshot-node/node_modules/

# examples/thumbnail-python vendors Pillow flat, Lambda-zip style, via
# `pip install -r requirements.txt -t .` (examples/thumbnail-python/README.md) —
# ignore everything pip drops in except the tracked source files.
examples/thumbnail-python/*
!examples/thumbnail-python/*.py
!examples/thumbnail-python/*.yml
!examples/thumbnail-python/*.txt
!examples/thumbnail-python/README.md

# Example output from README curl/manual testing
examples/**/*.png
examples/**/*.jpg
